#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) buffer Vel { float vel[]; };
layout(std430, binding = 2) readonly buffer VelOld { float velOld[]; };
layout(std430, binding = 3) buffer Kind { uint kind[]; };
layout(std430, binding = 4) readonly buffer Flags { uint cellFlags[]; };
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;

// Implicit viscosity, (1 - alpha * laplacian) u = u0 per velocity component, relaxed with red-black Gauss-Seidel.
// Pass 0 tags the faces, passes 1 and 2 relax the two colours. Faces touching a solid keep the wall (or entity)
// velocity, so the flow sticks to walls and floors; faces with air on both sides are left out (free surface).

#define FACE_AIR 0u
#define FACE_FLUID 1u
#define FACE_SOLID 2u

const ivec3 NB[6] = ivec3[](ivec3(1, 0, 0), ivec3(-1, 0, 0), ivec3(0, 1, 0), ivec3(0, -1, 0), ivec3(0, 0, 1), ivec3(0, 0, -1));

uint typeAt(ivec3 c) {
    return inBox(c) ? (cellFlags[cellIndex(c)] & 0xFFu) : CELL_AIR;
}

// How fast the flow shears around face i (1/s, cell units), from the velocities before the solve: the neighbours along
// each axis that carry liquid or a wall, central differences.
float strainRate(int comp, ivec3 f, int i) {
    float s = 0.0;
    for (int b = 0; b < 3; b++) {
        ivec3 e = axisVec(b);
        float up = velOld[i];
        float dn = velOld[i];
        if (faceInBox(comp, f + e) && kind[faceIndex(comp, f + e)] != FACE_AIR) {
            up = velOld[faceIndex(comp, f + e)];
        }
        if (faceInBox(comp, f - e) && kind[faceIndex(comp, f - e)] != FACE_AIR) {
            dn = velOld[faceIndex(comp, f - e)];
        }
        s += 0.25 * (up - dn) * (up - dn);
    }
    return sqrt(s);
}

void main() {
    int comp;
    ivec3 f;
    if (!boxFace(int(GID_U), comp, f)) {
        return;
    }
    int i = faceIndex(comp, f);
    if (pc.a.x == 0) {
        uint ta = typeAt(f - axisVec(comp));
        uint tb = typeAt(f);
        kind[i] = ta == CELL_SOLID || tb == CELL_SOLID ? FACE_SOLID : (ta == CELL_FLUID || tb == CELL_FLUID ? FACE_FLUID : FACE_AIR);
        return;
    }
    if (((f.x + f.y + f.z) & 1) != pc.a.x - 1 || kind[i] != FACE_FLUID) {
        return;
    }
    float sum = 0.0;
    float n = 0.0;
    for (int k = 0; k < 6; k++) {
        ivec3 nf = f + NB[k];
        if (!faceInBox(comp, nf)) {
            continue;
        }
        int j = faceIndex(comp, nf);
        if (kind[j] != FACE_AIR) {
            sum += vel[j];
            n += 1.0;
        }
    }
    float alpha = G.matC.x;
    if (G.matC.y > 0.0) {
        // A yield stress (mud): where the paste hardly shears it stiffens (regularized Bingham, yield / strain rate, capped),
        // so a heap slumps and then holds its shape instead of thinning out into a film.
        alpha = min(alpha + G.matC.y / max(strainRate(comp, f, i), 0.05), max(G.matC.z, alpha));
    }
    float u0 = velOld[i] + G.gravityDt[comp] * DT;
    vel[i] = (u0 + alpha * sum) / (1.0 + alpha * n);
}
