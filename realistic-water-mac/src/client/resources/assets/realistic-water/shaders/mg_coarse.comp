#version 450
#include "common.glsl"
#include "mg_common.glsl"
// 256 threads that own up to 4 cells each instead of one 1024-thread group: Metal (MoltenVK) caps
// threadgroups at 512 threads on older Macs and lowers the cap further for register-heavy pipelines.
#define COARSE_THREADS 256
#define COARSE_CELLS 1024
#define CELLS_PER_THREAD 4
layout(local_size_x = COARSE_THREADS) in;
layout(std430, binding = 1) readonly buffer MgFlags { uint mgFlags[]; };
layout(std430, binding = 2) readonly buffer B { float b[]; };
layout(std430, binding = 3) buffer X { float x[]; };

shared float sx[COARSE_CELLS];
shared float sb[COARSE_CELLS];
shared uint sf[COARSE_CELLS];

ivec3 cells[CELLS_PER_THREAD];

void relax(int t, int count, ivec3 c, ivec3 lo, ivec3 size, int parity) {
    if (t < count && sf[t] == CELL_FLUID && ((c.x + c.y + c.z) & 1) == parity) {
        float s = 0.0;
        float n = 0.0;
        for (int k = 0; k < 6; k++) {
            ivec3 nb = c + MG_NB[k] - lo;
            if (any(lessThan(nb, ivec3(0))) || any(greaterThanEqual(nb, size))) {
                n += 1.0;
                continue;
            }
            int j = nb.x + size.x * (nb.y + size.y * nb.z);
            if (j >= count) {
                n += 1.0;
                continue;
            }
            if (sf[j] == CELL_SOLID) {
                continue;
            }
            n += 1.0;
            if (sf[j] == CELL_FLUID) {
                s += sx[j];
            }
        }
        if (n > 0.0) {
            sx[t] = (sb[t] + s) / n;
        }
    }
}

void sweep(int count, ivec3 lo, ivec3 size, int parity) {
    for (int k = 0; k < CELLS_PER_THREAD; k++) {
        relax(int(gl_LocalInvocationID.x) + k * COARSE_THREADS, count, cells[k], lo, size, parity);
    }
    barrier();
}

void main() {
    int l = pc.misc.z;
    int count = min(lvlBoxCount(pc.dims, l), COARSE_CELLS);
    ivec3 lo = lvlBoxMin(l);
    ivec3 size = lvlBoxMax(l, pc.dims) - lo;
    int index[CELLS_PER_THREAD];
    for (int k = 0; k < CELLS_PER_THREAD; k++) {
        int t = int(gl_LocalInvocationID.x) + k * COARSE_THREADS;
        cells[k] = ivec3(0);
        index[k] = 0;
        if (t < count) {
            cells[k] = lvlBoxCell(t, pc.dims, l);
            index[k] = lvlIndex(cells[k], pc.dims);
            sf[t] = mgFlags[index[k]];
            sb[t] = b[index[k]];
            sx[t] = (pc.misc.y != 0 || sf[t] != CELL_FLUID) ? 0.0 : x[index[k]];
        }
    }
    barrier();
    int sweeps = max(pc.misc2.x, 1);
    for (int k = 0; k < sweeps; k++) {
        sweep(count, lo, size, 0);
        sweep(count, lo, size, 1);
    }
    for (int k = 0; k < sweeps; k++) {
        sweep(count, lo, size, 1);
        sweep(count, lo, size, 0);
    }
    for (int k = 0; k < CELLS_PER_THREAD; k++) {
        int t = int(gl_LocalInvocationID.x) + k * COARSE_THREADS;
        if (t < count) {
            x[index[k]] = sx[t];
        }
    }
}
